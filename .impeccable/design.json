      "html": "<label class=\"ds-field-label\" for=\"ds-email\">Email address</label><input class=\"ds-onboarding-input\" id=\"ds-email\" type=\"email\" autocomplete=\"email\" placeholder=\"you@example.com\">",
      "css": ".ds-field-label{font-family:lh-interface,Inter,sans-serif;display:block;margin-bottom:8px;color:#f3f5ee;font-size:12px;font-weight:500;line-height:1.6}.ds-onboarding-input{font-family:lh-interface,Inter,sans-serif;display:block;width:calc(100% - 30px);height:47px;padding:0 14px;border:1px solid #48514a;background:#1b211f;border-radius:11px;color:#f3f5ee;font-size:13px;transition:border-color .2s,box-shadow .2s,background .2s}.ds-onboarding-input::placeholder{color:#adb9ae}.ds-onboarding-input:hover{border-color:#6c7e6b}.ds-onboarding-input:focus-visible{outline:2px solid var(--landscape-accent,#b8d5aa);outline-offset:3px}.ds-onboarding-input:disabled{opacity:.45}@media(max-width:520px){.ds-onboarding-input{font-size:16px}}"
