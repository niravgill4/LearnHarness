      "description": "The established monochrome action treatment remains available on quiet workspace surfaces.",
      "html": "<button class=\"ds-workspace-primary\" type=\"button\">New session</button>",
      "css": ".ds-workspace-primary{font-family:lh-interface,Inter,sans-serif;background:var(--foreground,#f2f1f5);color:var(--background,#1a1a1e);border:1px solid transparent;border-radius:12px;padding:11px 16px;font-size:13px;font-weight:500;cursor:pointer;transition:opacity .18s}.ds-workspace-primary:hover{opacity:.88}.ds-workspace-primary:focus-visible{outline:2px solid var(--foreground,#f2f1f5);outline-offset:3px}.ds-workspace-primary:active{opacity:.75}"
