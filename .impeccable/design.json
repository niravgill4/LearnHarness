      "css": ".ds-onboarding-primary{font-family:lh-interface,Inter,sans-serif;display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:49px;padding:13px 16px;background:var(--landscape-accent,#b8d5aa);color:#17231a;border:1px solid var(--landscape-accent,#b8d5aa);border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;transition:background .2s,transform .2s,box-shadow .2s}.ds-onboarding-primary:hover:not(:disabled){background:color-mix(in srgb,var(--landscape-accent,#b8d5aa) 82%,white);box-shadow:0 5px 18px #00000020}.ds-onboarding-primary:focus-visible{outline:2px solid var(--landscape-accent,#b8d5aa);outline-offset:4px}.ds-onboarding-primary:active:not(:disabled){transform:scale(.985)}.ds-onboarding-primary:disabled{opacity:.45;cursor:not-allowed}"
